---
export interface Props {
  icon: 'pen' | 'box' | 'clock' | 'book' | 'search';
  title: string;
  message: string;
  buttonLabel?: string;
  buttonHref?: string;
  buttonVariant?: 'primary' | 'secondary';
}

const { icon, title, message, buttonLabel, buttonHref, buttonVariant = 'primary' } = Astro.props as Props;

const icons: Record<Props['icon'], string> = {
  pen: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
  box: '<path d="M21 8 12 3 3 8v8l9 5 9-5Z"/><path d="m3 8 9 5 9-5"/><path d="M12 13v8"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  book: '<path d="M4 19.5V5a2 2 0 0 1 2-2h14v16H6a2 2 0 0 0-2 2Z"/><path d="M20 19v3H6"/>',
  search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
};
---
<div class="flex flex-col items-center text-center gap-[10px] p-[clamp(36px,8vw,56px)_24px] border border-dashed border-border-dashed rounded-[12px]">
  <svg
    viewBox="0 0 24 24"
    width="28"
    height="28"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="text-muted-text"
    set:html={icons[icon]}
  />
  <p class="font-heading font-semibold text-[19px] text-primary-text">{title}</p>
  <p class="font-body text-[14.5px] leading-[1.55] text-secondary-text max-w-[380px]">{message}</p>
  {buttonLabel && buttonHref && (
    <a
      href={buttonHref}
      class:list={[
        'font-body font-medium text-[13px] rounded-[7px] px-[18px] min-h-[44px] inline-flex items-center mt-[6px]',
        buttonVariant === 'primary' ? 'bg-primary text-on-primary' : 'border border-border text-primary-text',
      ]}
    >
      {buttonLabel}
    </a>
  )}
</div>
