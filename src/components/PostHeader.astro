---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

export interface Props {
  title: string;
  dek: string;
  category: string;
  publishDate: string;
  modifiedDate?: string;
  tags?: string[];
  readingTime?: number;
  image?: string;
  imageAlt?: string;
}

const {
  title,
  dek,
  category,
  publishDate,
  modifiedDate,
  tags,
  readingTime,
  image,
  imageAlt,
} = Astro.props as Props;

const images = image ? import.meta.glob<{ default: ImageMetadata }>(`/src/images/**/*.{jpeg,jpg,png}`) : undefined;
const heroImage = images && image && `/src/images/${image}` in images ? await images[`/src/images/${image}`]() : undefined;

const formattedDate = new Date(publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const formattedModifiedDate = modifiedDate
  ? new Date(modifiedDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
  : undefined;
---
<header>
  <a href="/blog" class="inline-flex min-h-[44px] items-center font-mono text-[13px] text-primary hover:text-primary-hover">
    ← Notes
  </a>

  <p class="font-mono font-semibold text-[11.5px] uppercase tracking-[.06em] text-primary mt-4">{category}</p>

  <h1 class="font-heading font-semibold text-[clamp(26px,6vw,34px)] leading-[1.25] text-primary-text mt-1 mb-2">{title}</h1>

  <p class="font-body text-[17px] leading-[1.55] text-secondary-text">{dek}</p>

  <div class="flex flex-wrap items-center gap-3 font-mono text-[12.5px] text-muted-text mt-4">
    <span class="inline-flex items-center gap-1"><Icon name="calendar" />{formattedDate}</span>
    <span class="inline-flex items-center gap-1"><Icon name="clock" />{readingTime ?? 1} min read</span>
    {formattedModifiedDate && <span>(updated {formattedModifiedDate})</span>}
  </div>

  {tags && tags.length > 0 && (
    <div class="flex flex-wrap items-center gap-2 mt-2">
      <Icon name="tag" class="text-muted-text" />
      {tags.map((tag) => (
        <a href={`/blog?tag=${tag}`} class="font-mono text-[12.5px] text-primary underline hover:text-primary-hover">
          {tag}
        </a>
      ))}
    </div>
  )}

  {heroImage && (
    <Image
      src={heroImage.default}
      alt={imageAlt || title}
      width={1200}
      height={675}
      class="aspect-[16/9] w-full rounded-[10px] object-cover mt-6"
    />
  )}
</header>
