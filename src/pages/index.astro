---
import { Image } from 'astro:assets';
import Layout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';

import ProfilePicture from '../images/victortorres.jpg';

const { title, description } = site.pages.home;
const { heading, intro, cards } = site.home;
---

<Layout
	title={title}
	description={description}
	current="home"
>
	<div class="flex flex-col items-center text-center">
		<Image
			src={ProfilePicture}
			alt="Victor Torres profile picture"
			width={112}
			height={112}
			class="rounded-full border border-border mb-6"
		/>
		<h1 class="font-heading font-semibold text-[clamp(28px,6vw,36px)] leading-[1.2] text-primary-text">
			{heading}
		</h1>
		<p class="font-body text-[16.5px] leading-[1.6] text-body-text max-w-[460px] mt-4">
			{intro}
		</p>
		<div class="grid grid-cols-[repeat(auto-fit,minmax(170px,1fr))] gap-[14px] max-w-[600px] w-full mt-8">
			{cards.map((card) => (
				<a
					href={card.href}
					class="bg-surface border border-border rounded-[8px] p-[18px] text-left hover:border-primary-tag-border"
				>
					<h2 class="font-heading font-semibold text-[16px] text-primary-text">{card.title}</h2>
					<p class="font-body text-[13.5px] leading-[1.5] text-secondary-text mt-1">{card.description}</p>
				</a>
			))}
		</div>
	</div>
</Layout>
