---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
import NOW from '../data/now.json';

import ProfilePicture from '../images/victortorres.jpg';

const { title, description } = site.pages.home;
const { heading, intro, cards: allCards } = site.home;

const publishedProjects = await getCollection('projects', ({ data }) => data.status === 'published');

const hasContent: Record<string, boolean> = {
  '/projects': publishedProjects.length > 0,
  '/now': NOW.length > 0,
};

const cards = allCards.filter((card) => hasContent[card.href] ?? true);
---

<Layout
	title={title}
	description={description}
	current="home"
	centered
>
	<div class="flex flex-col items-center text-center">
		<Image
			src={ProfilePicture}
			alt="Victor Torres profile picture"
			width={200}
			height={200}
			class="rounded-full border border-border mb-6"
		/>
		<h1 class="font-heading font-black text-[clamp(34px,7.2vw,43px)] leading-[1.2] text-primary-text self-start">
			{heading}
		</h1>
		{intro.map((paragraph) => (
			<p class="font-body text-[25px] leading-[1.6] text-body-text mt-4 self-start text-left">
				{paragraph}
			</p>
		))}
		<div class="grid grid-cols-[repeat(auto-fit,minmax(170px,1fr))] gap-[14px] max-w-[400px] w-full mt-8">
			{cards.map((card) => (
				<a
					href={card.href}
					class="bg-surface border border-border rounded-[8px] p-[18px] text-left hover:border-primary-tag-border"
				>
					<h2 class="font-heading font-semibold text-[16px] text-primary-text">{card.title}</h2>
					<p class="font-body text-[13.5px] leading-[1.5] text-secondary-text mt-1">{card.description}</p>
				</a>
			))}
		</div>
	</div>
</Layout>
