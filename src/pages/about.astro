---
import Layout from '../layouts/BaseLayout.astro';
import { Image } from "astro:assets";

import ProfilePicture from '../images/victortorres.jpg';

const title = 'About'
const description = "About Victor Torres"

const socialLinks = [
	{ label: 'GitHub', href: 'https://github.com/vikthortt' },
	{ label: 'X', href: 'https://x.com/vikthortt' },
	{ label: 'Email', href: 'mailto:hello@victortorres.dev' },
];
---

<Layout
	title={title}
	description={description}
	current="about"
>
	<h1 class="font-heading font-semibold text-[28px] text-primary-text mb-6">About</h1>
	<div class="flex flex-wrap items-start gap-6">
		<Image
			src={ProfilePicture}
			alt="Victor Torres profile picture"
			width={130}
			height={130}
			class="rounded-[14px] border border-border shrink-0 object-cover"
		/>
		<div class="flex-1 min-w-[280px]">
			<p class="font-body text-[16px] leading-[1.7] text-body-text mb-4">
				Hey, I'm Victor — a software developer based in Guadalajara, Mexico. I build clean, scalable and delightful web applications, and I write about the messy parts of shipping good UI: the frameworks, tradeoffs and full-stack workflows I run into along the way.
			</p>
			<p class="font-body text-[16px] leading-[1.7] text-body-text mb-4">
				This site is my digital lab — part archive, part playground, mostly written for future me. When I'm not coding, I'm probably studying something new, reading, watching anime, or playing a video game. Thanks for being here.
			</p>
			<div class="flex flex-wrap gap-4 font-mono text-[14px] text-primary">
				{socialLinks.map((social) => (
					<a
						href={social.href}
						class="hover:text-primary-hover"
						target={social.href.startsWith('http') ? '_blank' : undefined}
						rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
					>
						{social.label}
					</a>
				))}
			</div>
		</div>
	</div>
</Layout>
