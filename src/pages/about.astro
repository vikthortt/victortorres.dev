---
import Layout from '../layouts/BaseLayout.astro';
import { Image } from "astro:assets";

import ProfilePicture from '../images/victortorres.jpg';
import { EXPERIENCE, SKILLS, EDUCATION } from '../data/resume';

const title = 'About'
const description = "About Victor Torres — bio and résumé."
---

<Layout
	title={title}
	description={description}
	current="about"
>
	<div class="flex flex-wrap items-start gap-6">
		<Image
			src={ProfilePicture}
			alt="Victor Torres profile picture"
			width={130}
			height={130}
			class="rounded-[14px] border border-border shrink-0 object-cover"
		/>
		<div class="flex-1 min-w-[280px]">
			<p class="font-body text-[16px] leading-[1.7] text-body-text mb-4">
				Hey, I'm Victor — a software developer based in Guadalajara, Mexico. I build clean, scalable and delightful web applications, and I write about the messy parts of shipping good UI: the frameworks, tradeoffs and full-stack workflows I run into along the way.
			</p>
			<div class="flex flex-wrap gap-3">
				<a
					href="/resume.pdf"
					class="inline-flex h-[44px] items-center rounded-[7px] bg-primary px-6 font-heading font-semibold text-on-primary"
				>
					Download résumé (PDF)
				</a>
				<a
					href="mailto:hello@victortorres.dev"
					class="inline-flex h-[44px] items-center rounded-[7px] border border-border px-6 font-heading font-semibold text-primary-text"
				>
					Get in touch
				</a>
			</div>
		</div>
	</div>

	<div class="mt-12">
		<h2 class="font-mono font-semibold text-[13px] uppercase tracking-[.06em] text-muted-text mb-4">Experience</h2>
		<div class="flex flex-col gap-6">
			{EXPERIENCE.map((entry) => (
				<div class="flex flex-wrap gap-4">
					<p class="w-[130px] shrink-0 font-mono text-[12.5px] text-muted-text">{entry.years}</p>
					<div class="flex-1 min-w-[200px]">
						<p class="font-heading font-semibold text-[16px] text-primary-text">{entry.role} · {entry.company}</p>
						<p class="font-body text-[15px] leading-[1.6] text-secondary-text mt-1">{entry.summary}</p>
					</div>
				</div>
			))}
		</div>
	</div>

	<div class="mt-10">
		<h2 class="font-mono font-semibold text-[13px] uppercase tracking-[.06em] text-muted-text mb-4">Skills</h2>
		<div class="flex flex-wrap gap-2">
			{SKILLS.map((skill) => (
				<span class="font-mono text-[12.5px] text-primary border border-primary-tag-border rounded-[20px] px-3 py-1">
					{skill}
				</span>
			))}
		</div>
	</div>

	<div class="mt-10">
		<h2 class="font-mono font-semibold text-[13px] uppercase tracking-[.06em] text-muted-text mb-4">Education</h2>
		<div class="flex flex-col gap-4">
			{EDUCATION.map((entry) => (
				<div class="flex flex-wrap gap-4">
					<p class="w-[130px] shrink-0 font-mono text-[12.5px] text-muted-text">{entry.years}</p>
					<p class="font-body text-[15px] text-body-text">{entry.degree} · {entry.school}</p>
				</div>
			))}
		</div>
	</div>
</Layout>
