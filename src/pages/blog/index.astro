---
import Layout from '../../layouts/BaseLayout.astro'
import { getCollection } from "astro:content";
import NoteCard from '../../components/NoteCard.astro';
import Icon from '../../components/Icon.astro';
import site from '../../data/site.json';

const { title, description, subtitle } = site.pages.notes;

// This is a static site: query strings never reach the server, so all
// filtering (category, tag, search) happens client-side in the <script>
// below, driven by location.search. The markup below renders the
// unfiltered, no-JS default state.
const allPublishedPosts = (await getCollection('blog', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.created_date.valueOf() - a.data.created_date.valueOf());

const categories = [...new Set(allPublishedPosts.map((post) => post.data.category))].sort();
const showCategoryFilter = categories.length > 2 && allPublishedPosts.length > 5;
const showSearch = allPublishedPosts.length >= 5;

const featuredPost = allPublishedPosts.find((post) => post.data.featured);
const listPosts = allPublishedPosts.filter((post) => post.id !== featuredPost?.id);

const groupedByYear = listPosts.reduce<Map<number, typeof listPosts>>((groups, post) => {
  const year = post.data.created_date.getFullYear();
  const group = groups.get(year) ?? [];
  group.push(post);
  groups.set(year, group);
  return groups;
}, new Map());

const pillBase = 'inline-flex h-[36px] items-center rounded-[20px] px-[14px] font-mono text-[13px]';
---

<Layout
  title={title}
  description={description}
  current="notes"
>
  <h1 class="font-heading font-semibold text-[28px] text-primary-text">{title}</h1>
  <p class="font-body text-[15px] text-secondary-text mt-1">{subtitle}</p>

  {allPublishedPosts.length === 0 && (
    <p class="font-body text-[16px] leading-[1.6] text-secondary-text mt-8">
      No notes yet — I'm still writing. Come back soon.
    </p>
  )}

  {allPublishedPosts.length > 0 && showSearch && (
    <form method="get" action="/blog" data-search-form class="mt-6">
      <div class="relative">
        <Icon name="search" class="absolute left-[14px] top-1/2 -translate-y-1/2 text-muted-text" />
        <input
          type="search"
          name="q"
          data-search-input
          placeholder="Search notes..."
          class="h-[44px] w-full rounded-[8px] border border-border bg-surface pl-[40px] pr-[14px] font-body text-[15px] text-primary-text placeholder:text-muted-text focus:border-primary"
        />
      </div>
    </form>
  )}

  {allPublishedPosts.length > 0 && (
    <Fragment>
      {showCategoryFilter && (
        <div class="flex flex-wrap gap-2 mt-6" data-category-pills>
          <a href="/blog" data-category-pill="" class={`${pillBase} bg-primary text-on-primary`}>All</a>
          {categories.map((category) => (
            <a href={`/blog?category=${category}`} data-category-pill={category} class={`${pillBase} text-secondary-text border border-border hover:border-primary-tag-border`}>{category}</a>
          ))}
        </div>
      )}

      <p data-tag-notice class="hidden font-mono text-[13px] text-secondary-text mt-4">
        Tagged <span data-tag-notice-value class="text-primary"></span> · <a href="/blog" data-tag-clear class="text-primary hover:text-primary-hover">Clear ×</a>
      </p>

      <div data-featured-wrapper class="mt-8">
        {featuredPost && (
          <NoteCard
            id={featuredPost.id}
            url={`/blog/${featuredPost.id}`}
            title={featuredPost.data.title}
            dek={featuredPost.data.description}
            category={featuredPost.data.category}
            date={featuredPost.data.created_date}
            readingTime={featuredPost.data.reading_time ?? 1}
            tags={featuredPost.data.tags}
            cover={featuredPost.data.image}
            coverAlt={featuredPost.data.image_alt}
            featured
          />
        )}
      </div>

      <div class="flex flex-col gap-8 mt-8" data-note-groups>
        {[...groupedByYear.entries()].map(([year, posts]) => (
          <div data-note-group>
            <h2 class="font-mono font-semibold text-[13px] uppercase tracking-[.06em] text-muted-text mb-3">{year}</h2>
            <div class="flex flex-col gap-4">
              {posts.map((post) => (
                <NoteCard
                  id={post.id}
                  url={`/blog/${post.id}`}
                  title={post.data.title}
                  dek={post.data.description}
                  category={post.data.category}
                  date={post.data.created_date}
                  readingTime={post.data.reading_time ?? 1}
                  tags={post.data.tags}
                  cover={post.data.image}
                  coverAlt={post.data.image_alt}
                />
              ))}
              {featuredPost && (
                <NoteCard
                  id={featuredPost.id}
                  url={`/blog/${featuredPost.id}`}
                  title={featuredPost.data.title}
                  dek={featuredPost.data.description}
                  category={featuredPost.data.category}
                  date={featuredPost.data.created_date}
                  readingTime={featuredPost.data.reading_time ?? 1}
                  tags={featuredPost.data.tags}
                  cover={featuredPost.data.image}
                  coverAlt={featuredPost.data.image_alt}
                  hiddenDuplicate
                />
              )}
            </div>
          </div>
        ))}
      </div>

      <p data-empty-state class="hidden font-body text-[16px] text-secondary-text mt-8">No notes match your filters.</p>
    </Fragment>
  )}
</Layout>

<script>
  const pillBase = 'inline-flex h-[36px] items-center rounded-[20px] px-[14px] font-mono text-[13px]';
  const pillActive = `${pillBase} bg-primary text-on-primary`;
  const pillInactive = `${pillBase} text-secondary-text border border-border hover:border-primary-tag-border`;

  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-note-card]'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-note-group]'));
  const pills = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-category-pill]'));
  const featuredWrapper = document.querySelector<HTMLElement>('[data-featured-wrapper]');
  const featuredCard = featuredWrapper?.querySelector<HTMLElement>('[data-note-card]') ?? null;
  const tagNotice = document.querySelector<HTMLElement>('[data-tag-notice]');
  const tagNoticeValue = document.querySelector<HTMLElement>('[data-tag-notice-value]');
  const tagClear = document.querySelector<HTMLAnchorElement>('[data-tag-clear]');
  const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');
  const searchInput = document.querySelector<HTMLInputElement>('[data-search-input]');
  const searchForm = document.querySelector<HTMLFormElement>('[data-search-form]');

  const readState = () => {
    const params = new URLSearchParams(location.search);
    return {
      category: params.get('category') || '',
      tag: params.get('tag') || '',
      q: (params.get('q') || '').trim().toLowerCase(),
    };
  };

  const buildUrl = (state: { category: string; tag: string; q: string }) => {
    const params = new URLSearchParams();
    if (state.category) params.set('category', state.category);
    if (state.tag) params.set('tag', state.tag);
    if (state.q) params.set('q', state.q);
    const qs = params.toString();
    return qs ? `/blog?${qs}` : '/blog';
  };

  const apply = (state: { category: string; tag: string; q: string }) => {
    const hasFilter = Boolean(state.category || state.tag || state.q);

    if (featuredWrapper) featuredWrapper.classList.toggle('hidden', hasFilter);

    let visibleCount = 0;
    for (const card of cards) {
      if (card === featuredCard) continue;
      const category = card.dataset.category || '';
      const tags = (card.dataset.tags || '').split(',').filter(Boolean);
      const search = card.dataset.search || '';
      const isFeaturedDuplicate = card.dataset.featuredDuplicate === 'true';
      const matches =
        (!isFeaturedDuplicate || hasFilter) &&
        (!state.category || category === state.category) &&
        (!state.tag || tags.includes(state.tag)) &&
        (!state.q || search.includes(state.q));
      card.classList.toggle('hidden', !matches);
      if (matches) visibleCount += 1;
    }

    for (const group of groups) {
      const visible = Array.from(group.querySelectorAll<HTMLElement>('[data-note-card]')).some(
        (card) => !card.classList.contains('hidden'),
      );
      group.classList.toggle('hidden', !visible);
    }

    for (const pill of pills) {
      const isActive = (pill.dataset.categoryPill || '') === state.category;
      pill.className = isActive ? pillActive : pillInactive;
    }

    if (tagNotice && tagNoticeValue) {
      tagNotice.classList.toggle('hidden', !state.tag);
      tagNoticeValue.textContent = state.tag;
    }
    if (tagClear) tagClear.href = buildUrl({ category: state.category, tag: '', q: state.q });

    if (emptyState) emptyState.classList.toggle('hidden', visibleCount > 0 || (!hasFilter && Boolean(featuredCard)));

    if (searchInput) searchInput.value = state.q;
  };

  apply(readState());

  for (const pill of pills) {
    pill.addEventListener('click', (event) => {
      event.preventDefault();
      const state = readState();
      state.category = pill.dataset.categoryPill || '';
      const url = buildUrl(state);
      history.pushState(null, '', url);
      apply(state);
    });
  }

  if (tagClear) {
    tagClear.addEventListener('click', (event) => {
      event.preventDefault();
      const state = readState();
      state.tag = '';
      const url = buildUrl(state);
      history.pushState(null, '', url);
      apply(state);
    });
  }

  for (const card of cards) {
    card.querySelectorAll<HTMLAnchorElement>('[data-tag-link]').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const state = readState();
        state.tag = link.dataset.tagLink || '';
        const url = buildUrl(state);
        history.pushState(null, '', url);
        apply(state);
        window.scrollTo({ top: 0 });
      });
    });
  }

  if (searchForm && searchInput) {
    searchForm.addEventListener('submit', (event) => {
      event.preventDefault();
    });
    searchInput.addEventListener('input', () => {
      const state = readState();
      state.q = searchInput.value.trim().toLowerCase();
      const url = buildUrl(state);
      history.replaceState(null, '', url);
      apply(state);
    });
  }

  window.addEventListener('popstate', () => apply(readState()));
</script>
