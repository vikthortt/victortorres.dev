---
import Layout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { RESOURCES } from '../data/resources';

const title = 'Resources'
const description = "Victor Torres's list of useful content — blogs, books, tools and courses."

const types = ['Blog', 'Book', 'Tool', 'Course'] as const;

const pillBase = 'inline-flex h-[36px] items-center rounded-[20px] px-[14px] font-mono text-[13px]';
---

<Layout
  title={title}
  description={description}
  current="resources"
>
  <h1 class="font-heading font-semibold text-[28px] text-primary-text mb-6">Resources</h1>

  <form method="get" action="/resources" data-search-form>
    <div class="relative">
      <Icon name="search" class="absolute left-[14px] top-1/2 -translate-y-1/2 text-muted-text" />
      <input
        type="search"
        name="q"
        data-search-input
        placeholder="Search resources..."
        class="h-[44px] w-full rounded-[8px] border border-border bg-surface pl-[40px] pr-[14px] font-body text-[15px] text-primary-text placeholder:text-muted-text focus:border-primary"
      />
    </div>
  </form>

  <div class="flex flex-wrap gap-2 mt-6" data-type-pills>
    <a href="/resources" data-type-pill="" class={`${pillBase} bg-primary text-on-primary`}>All</a>
    {types.map((type) => (
      <a href={`/resources?type=${type}`} data-type-pill={type} class={`${pillBase} text-secondary-text border border-border hover:border-primary-tag-border`}>{type}s</a>
    ))}
  </div>

  <div class="flex flex-col mt-8" data-resource-list>
    {RESOURCES.map((resource) => (
      <a
        href={resource.url}
        target="_blank"
        rel="noopener noreferrer"
        data-resource-row
        data-type={resource.type}
        data-search={`${resource.title} ${resource.by} ${resource.note}`.toLowerCase()}
        class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 border-b border-border py-[14px] hover:bg-[rgba(255,255,255,.03)]"
      >
        <p class="font-heading font-semibold text-[16px] text-primary-text">
          {resource.title} <span class="font-body font-normal text-secondary-text">— {resource.by}</span>
        </p>
        <span class="font-mono text-[12px] uppercase tracking-[.06em] text-primary">{resource.type}</span>
        <p class="font-body text-[14px] leading-[1.5] text-secondary-text w-full">{resource.note}</p>
        <p class="font-mono text-[12px] text-muted-text">Found {resource.found}</p>
      </a>
    ))}
  </div>

  <p data-empty-state class="hidden font-body text-[16px] text-secondary-text mt-8">No resources match your filters.</p>
</Layout>

<script>
  const pillBase = 'inline-flex h-[36px] items-center rounded-[20px] px-[14px] font-mono text-[13px]';
  const pillActive = `${pillBase} bg-primary text-on-primary`;
  const pillInactive = `${pillBase} text-secondary-text border border-border hover:border-primary-tag-border`;

  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-resource-row]'));
  const pills = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-type-pill]'));
  const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');
  const searchInput = document.querySelector<HTMLInputElement>('[data-search-input]');
  const searchForm = document.querySelector<HTMLFormElement>('[data-search-form]');

  const readState = () => {
    const params = new URLSearchParams(location.search);
    return {
      type: params.get('type') || '',
      q: (params.get('q') || '').trim().toLowerCase(),
    };
  };

  const buildUrl = (state: { type: string; q: string }) => {
    const params = new URLSearchParams();
    if (state.type) params.set('type', state.type);
    if (state.q) params.set('q', state.q);
    const qs = params.toString();
    return qs ? `/resources?${qs}` : '/resources';
  };

  const apply = (state: { type: string; q: string }) => {
    let visibleCount = 0;
    for (const row of rows) {
      const type = row.dataset.type || '';
      const search = row.dataset.search || '';
      const matches = (!state.type || type === state.type) && (!state.q || search.includes(state.q));
      row.classList.toggle('hidden', !matches);
      if (matches) visibleCount += 1;
    }

    for (const pill of pills) {
      const isActive = (pill.dataset.typePill || '') === state.type;
      pill.className = isActive ? pillActive : pillInactive;
    }

    if (emptyState) emptyState.classList.toggle('hidden', visibleCount > 0);
    if (searchInput) searchInput.value = state.q;
  };

  apply(readState());

  for (const pill of pills) {
    pill.addEventListener('click', (event) => {
      event.preventDefault();
      const state = readState();
      state.type = pill.dataset.typePill || '';
      history.pushState(null, '', buildUrl(state));
      apply(state);
    });
  }

  if (searchForm && searchInput) {
    searchForm.addEventListener('submit', (event) => event.preventDefault());
    searchInput.addEventListener('input', () => {
      const state = readState();
      state.q = searchInput.value.trim().toLowerCase();
      history.replaceState(null, '', buildUrl(state));
      apply(state);
    });
  }

  window.addEventListener('popstate', () => apply(readState()));
</script>
