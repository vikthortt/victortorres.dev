---
import Layout from '../../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';

const title = 'Projects'
const description = "Things I've built."

const projects = await getCollection('projects', ({ data }) => data.status === 'published');
---

<Layout
  title={title}
  description={description}
  current="projects"
>
  <h1 class="font-heading font-semibold text-[24px] text-primary-text mb-6">Projects</h1>

  {projects.length > 0 ? (
    <div class="grid grid-cols-[repeat(auto-fill,minmax(240px,1fr))] gap-[18px]">
      {projects.map((project) => (
        <ProjectCard
          url={`/projects/${project.id}`}
          name={project.data.name}
          description={project.data.description}
          tag={project.data.tag}
        />
      ))}
    </div>
  ) : (
    <p class="font-body text-[16px] text-secondary-text">Nothing published yet — check back soon.</p>
  )}
</Layout>
