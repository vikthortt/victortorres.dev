---
import Layout from '../../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import Icon from '../../components/Icon.astro';
import site from '../../data/site.json';

const { title, description } = site.pages.projects;

const languages = ['TypeScript', 'React', 'Rust'] as const;

const projects = (await getCollection('projects', ({ data }) => data.status === 'published'))
  .sort((a, b) => {
    if (a.data.projectStatus !== b.data.projectStatus) {
      return a.data.projectStatus === 'Active' ? -1 : 1;
    }
    return a.data.name.localeCompare(b.data.name);
  });

const pillBase = 'inline-flex h-[36px] items-center rounded-[20px] px-[14px] font-mono text-[13px]';
---

<Layout
  title={title}
  description={description}
  current="projects"
>
  <h1 class="font-heading font-semibold text-[28px] text-primary-text mb-6">{title}</h1>

  <form method="get" action="/projects" data-search-form>
    <div class="relative">
      <Icon name="search" class="absolute left-[14px] top-1/2 -translate-y-1/2 text-muted-text" />
      <input
        type="search"
        name="q"
        data-search-input
        placeholder="Search projects..."
        class="h-[44px] w-full rounded-[8px] border border-border bg-surface pl-[40px] pr-[14px] font-body text-[15px] text-primary-text placeholder:text-muted-text focus:border-primary"
      />
    </div>
  </form>

  <div class="flex flex-wrap gap-2 mt-6" data-language-pills>
    <a href="/projects" data-language-pill="" class={`${pillBase} bg-primary text-on-primary`}>All</a>
    {languages.map((language) => (
      <a href={`/projects?language=${language}`} data-language-pill={language} class={`${pillBase} text-secondary-text border border-border hover:border-primary-tag-border`}>{language}</a>
    ))}
  </div>

  {projects.length > 0 ? (
    <div class="grid grid-cols-[repeat(auto-fill,minmax(240px,1fr))] gap-[18px] mt-8" data-project-grid>
      {projects.map((project) => (
        <ProjectCard
          id={project.id}
          url={`/projects/${project.id}`}
          name={project.data.name}
          description={project.data.description}
          language={project.data.language}
          projectStatus={project.data.projectStatus}
        />
      ))}
    </div>
  ) : (
    <p class="font-body text-[16px] text-secondary-text mt-8">Nothing published yet — check back soon.</p>
  )}

  <p data-empty-state class="hidden font-body text-[16px] text-secondary-text mt-8">No projects match your filters.</p>
</Layout>

<script>
  const pillBase = 'inline-flex h-[36px] items-center rounded-[20px] px-[14px] font-mono text-[13px]';
  const pillActive = `${pillBase} bg-primary text-on-primary`;
  const pillInactive = `${pillBase} text-secondary-text border border-border hover:border-primary-tag-border`;

  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-project-card]'));
  const pills = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-language-pill]'));
  const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');
  const searchInput = document.querySelector<HTMLInputElement>('[data-search-input]');
  const searchForm = document.querySelector<HTMLFormElement>('[data-search-form]');

  const readState = () => {
    const params = new URLSearchParams(location.search);
    return {
      language: params.get('language') || '',
      q: (params.get('q') || '').trim().toLowerCase(),
    };
  };

  const buildUrl = (state: { language: string; q: string }) => {
    const params = new URLSearchParams();
    if (state.language) params.set('language', state.language);
    if (state.q) params.set('q', state.q);
    const qs = params.toString();
    return qs ? `/projects?${qs}` : '/projects';
  };

  const apply = (state: { language: string; q: string }) => {
    let visibleCount = 0;
    for (const card of cards) {
      const language = card.dataset.language || '';
      const search = card.dataset.search || '';
      const matches = (!state.language || language === state.language) && (!state.q || search.includes(state.q));
      card.classList.toggle('hidden', !matches);
      if (matches) visibleCount += 1;
    }

    for (const pill of pills) {
      const isActive = (pill.dataset.languagePill || '') === state.language;
      pill.className = isActive ? pillActive : pillInactive;
    }

    if (emptyState) emptyState.classList.toggle('hidden', cards.length === 0 || visibleCount > 0);
    if (searchInput) searchInput.value = state.q;
  };

  apply(readState());

  for (const pill of pills) {
    pill.addEventListener('click', (event) => {
      event.preventDefault();
      const state = readState();
      state.language = pill.dataset.languagePill || '';
      history.pushState(null, '', buildUrl(state));
      apply(state);
    });
  }

  if (searchForm && searchInput) {
    searchForm.addEventListener('submit', (event) => event.preventDefault());
    searchInput.addEventListener('input', () => {
      const state = readState();
      state.q = searchInput.value.trim().toLowerCase();
      history.replaceState(null, '', buildUrl(state));
      apply(state);
    });
  }

  window.addEventListener('popstate', () => apply(readState()));
</script>
