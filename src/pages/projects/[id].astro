---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/BaseLayout.astro';
import Prose from '../../components/Prose.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { name, description, language, projectStatus, years, license, githubUrl, writeupUrl, icon, image, imageAlt } = project.data;
const { Content } = await render(project);

const icons = icon ? import.meta.glob<{ default: ImageMetadata }>(`/src/images/**/*.{jpeg,jpg,png,svg}`) : undefined;
const iconImage = icons && icon && `/src/images/${icon}` in icons ? await icons[`/src/images/${icon}`]() : undefined;

const images = image ? import.meta.glob<{ default: ImageMetadata }>(`/src/images/**/*.{jpeg,jpg,png}`) : undefined;
const heroImage = images && image && `/src/images/${image}` in images ? await images[`/src/images/${image}`]() : undefined;
---

<Layout
  title={name}
  description={description}
  current="projects"
>
  <a href="/projects" class="inline-flex min-h-[44px] items-center font-mono text-[13px] text-primary hover:text-primary-hover">
    ← Projects
  </a>

  <div class="flex items-center gap-3 mt-4">
    <div class="h-[48px] w-[48px] shrink-0 rounded-[10px] bg-placeholder overflow-hidden">
      {iconImage && <Image src={iconImage.default} alt="" width={48} height={48} />}
    </div>
    <h1 class="font-heading font-semibold text-[clamp(24px,6vw,28px)] text-primary-text">{name}</h1>
  </div>

  <p class="font-body text-[16px] leading-[1.7] text-body-text mt-4">{description}</p>

  <p class="font-mono text-[12px] text-muted-text mt-3 flex flex-wrap gap-x-2">
    <span>{language}</span>
    <span aria-hidden="true">·</span>
    <span>{years}</span>
    <span aria-hidden="true">·</span>
    <span class:list={[projectStatus === 'Active' && 'text-primary']}>{projectStatus}</span>
    <span aria-hidden="true">·</span>
    <span>{license} license</span>
  </p>

  <div class="flex flex-wrap gap-3 mt-4">
    {githubUrl && (
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-[44px] items-center rounded-[7px] bg-primary px-6 font-heading font-semibold text-on-primary"
      >
        View on GitHub
      </a>
    )}
    {writeupUrl && (
      <a
        href={writeupUrl}
        class="inline-flex h-[44px] items-center rounded-[7px] border border-border px-6 font-heading font-semibold text-primary-text"
      >
        Read the writeup
      </a>
    )}
  </div>

  <div class="h-[clamp(180px,40vw,260px)] w-full rounded-[10px] border border-dashed border-border bg-placeholder mt-6 overflow-hidden">
    {heroImage && <Image src={heroImage.default} alt={imageAlt || name} width={1200} height={600} class="h-full w-full object-cover" />}
  </div>

  <div class="mt-6">
    <Prose>
      <Content />
    </Prose>
  </div>
</Layout>
