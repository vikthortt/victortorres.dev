---
import Layout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
import USES from '../data/uses.json';

const { title, description, subtitle } = site.pages.uses;
---

<Layout
	title={title}
	description={description}
	current="uses"
>
	<h1 class="font-heading font-semibold text-[28px] text-primary-text">{title}</h1>
	<p class="font-body text-[15px] text-secondary-text mt-1">{subtitle}</p>

	<div class="flex flex-col gap-8 mt-8">
		{USES.map((group) => (
			<div>
				<h2 class="font-mono font-semibold text-[13px] uppercase tracking-[.06em] text-muted-text mb-3">{group.group}</h2>
				<ul class="flex flex-col gap-3">
					{group.items.map((item) => (
						<li class="grid grid-cols-1 sm:grid-cols-[220px_1fr] gap-x-4 gap-y-1">
							<span class="font-body font-semibold text-[16px] text-primary-text">{item.name}</span>
							<span class="font-body text-[15px] text-secondary-text">{item.note}</span>
						</li>
					))}
				</ul>
			</div>
		))}
	</div>
</Layout>
